{#
/**
 * @file
 * Hero section rendered by the sacda_hero block.
 *
 * Markup mirrors the sacda theme's hero.twig section() macro so the compiled
 * Tailwind CSS covers it; the theme may override this template.
 *
 * Available variables:
 * - title: Hero title.
 * - subtitle: Hero subtitle.
 * - image: Background image URL ('' for the solid fallback).
 */
#}
<section class="hero-section relative w-full h-80 md:h-96 flex flex-col justify-center items-center text-center overflow-hidden">
	{# Background Image #}
	{% if image %}
		<img src="{{ image }}" alt="" class="absolute inset-0 w-full h-full object-cover">
		<div class="absolute inset-0 bg-primary/75"></div>
	{% else %}
		<div class="absolute inset-0 bg-primary"></div>
	{% endif %}

	{# Content #}
	<div class="hero-content relative z-10 px-4 max-w-7xl mx-auto w-full">
		{% if title %}
			<span class="text-4xl md:text-5xl lg:text-6xl font-black text-white! mb-4 uppercase">
				{{ title }}
			</span>
		{% endif %}
		{% if subtitle %}
			<p class="text-lg md:text-xl text-white/90 max-w-3xl mx-auto">
				{{ subtitle }}
			</p>
		{% endif %}
	</div>
</section>
